# Copy this file to `.env` (which is gitignored) and fill in the values.
# Both the server and `make spotify-auth` load this file automatically.

# Server listen address (optional; defaults to :8080)
SERVER_ADDR=:8080

# --- Spotify "now playing" badge ---
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Set its Redirect URI to EXACTLY: http://127.0.0.1:8888/callback
#    (Spotify rejects http://localhost and plain-HTTP non-loopback URIs as of Nov 2025.)
# 3. Copy the Client ID and Client Secret here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 4. With the two values above filled in, run `make spotify-auth` and follow the
#    prompts. It prints a refresh token — paste it here.
SPOTIFY_REFRESH_TOKEN=
